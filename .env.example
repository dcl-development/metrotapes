# Copy to .env.local for local dev. On Vercel, set these in Project Settings > Environment Variables.
# None of these use the VITE_ prefix: they are read only by the /api functions and never reach the browser.
# Don't add VITE_* secrets. The build fails if a secret value ends up in the bundle.

# YouTube Data API key for /api/videos. Optional: without it the playlist RSS feed is used (no durations).
YOUTUBE_API_KEY=

# Optional overrides for the /api functions. Defaults are the production project (l3itmzli / production).
# The dataset is public, so no Sanity token is needed.
SANITY_PROJECT_ID=
SANITY_DATASET=
